### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# The native collector is shipped as part of the agent and pins its dependency graph.
Cargo.lock
!jonoffcpu-native/Cargo.lock

# Gradle build state
.gradle/
build/
**/build/

# These are backup files generated by rustfmt
**/*.rs.bk
.ccls-cache

# Generated Python integration-tool bytecode
__pycache__/
*.py[cod]

# IDEs and editors
.idea/
*.iml
.vscode/
.fleet/
.classpath
.project
.settings/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
